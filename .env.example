# ─── Site ────────────────────────────────────────────────────────────
# Public production URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://reelclicks.in

# ─── Sanity CMS ──────────────────────────────────────────────────────
# Leave blank to run the site on the bundled sample content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Optional read token (only needed if the dataset is private)
SANITY_API_READ_TOKEN=
# Shared secret configured on the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# ─── Enquiry e-mail (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "REELCLICKS <enquiries@reelclicks.in>"
ENQUIRY_FROM_EMAIL=
# Where enquiries are delivered (comma separated for several inboxes)
ENQUIRY_TO_EMAIL=huzefshaikh940@gmail.com
